# ============================================
# NusantaraExport.AI — Environment Variables
# ============================================
# Salin file ini ke .env dan sesuaikan nilainya.

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
AUTH_DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# --- Backend (FastAPI) ---
BACKEND_PORT=8081
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,https://nusantaraexport-ai.vercel.app

# --- Frontend (React + Vite) ---
VITE_API_BASE_URL=http://localhost:8081

# --- AI Services ---
AI_SERVICE_PORT=8082
AI_SERVICE_URL=http://localhost:8082

# --- Whisper ASR ---
WHISPER_MODEL_SIZE=base

# --- LLM (Gemini — Primary AI Engine) ---
GEMINI_API_KEY=
# Model options: gemini-2.0-flash (recommended), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash
BACKUP_LLM_PROVIDER=huggingface
GEMINI_API_KEY=
BACKUP_LLM_API_KEY=
BACKUP_LLM_PROVIDER=gemini
CENDOL_API_KEY=

# --- Scraper ---
SCRAPER_HEADLESS=true

# --- Auth (JWT) ---
JWT_SECRET_KEY=ganti-dengan-secret-key-panjang-dan-acak-minimal-32-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Market Data ---
COMTRADE_API_KEY=

# --- WhatsApp Bot (Fonnte) ---
# Daftar di https://fonnte.com dan connect nomor WA Anda
FONNTE_TOKEN=
# Token verifikasi opsional untuk keamanan webhook
FONNTE_VERIFY_TOKEN=nusantara_wa_verify

