# ============================================
# NusantaraExport.AI — Environment Variables
# ============================================
# Salin file ini ke .env dan sesuaikan nilainya.

# --- Database (PostgreSQL + pgvector) ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Backend (FastAPI) ---
BACKEND_PORT=
NODE_ENV=

# --- Frontend (React + Vite) ---
VITE_API_BASE_URL=

# --- AI Services (FastAPI) ---
AI_SERVICE_PORT=
AI_SERVICE_URL=

# --- Whisper ASR ---
WHISPER_MODEL_SIZE=

# --- LLM (Cendol) ---
LLM_API_KEY=
LLM_MODEL_NAME=

# --- Scraper ---
SCRAPER_HEADLESS=

# --- Auth (JWT) ---
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# --- Auth Database (PostgreSQL on port 5432) ---
AUTH_DATABASE_URL=
COMTRADE_API_KEY=
GEMINI_API_KEY=
