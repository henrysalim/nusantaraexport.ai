# ==========================================
# NusantaraExport.AI — Konfigurasi Lingkungan
# ==========================================

# ------------------------------------------
# API Kunci LLM (Pilih Salah Satu atau Semuanya)
# ------------------------------------------
# 1. CENDOL NLP (Opsi Lokal dengan library Transformers)
# Jika Proposal Hackathon Anda mengharuskan pemrosesan 100% LOKAL di laptop (tanpa API internet), 
# set value ini menjadi "true" (Catatan: Butuh RAM min. 16GB dan akan download model ~14GB).
USE_LOCAL_CENDOL=false

# 2. CENDOL NLP (Via HuggingFace Inference API)
# Opsi jauh lebih ringan: Tetap pakai Cendol tapi via Cloud HuggingFace.
CENDOL_API_KEY=
CENDOL_API_URL=https://api-inference.huggingface.co/models/indonlp/cendol-llama2-7b-chat

# 3. GEMINI API (Sebagai Fallback / Cadangan yang Sangat Cerdas)
# REKOMENDASI HACKATHON: Wajib diisi agar fitur RAG dan AI Insights bisa berjalan 100% REAL.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------
# Konfigurasi Database (Opsional)
# ------------------------------------------
# Jika tidak diisi, backend akan menggunakan mock data secara otomatis
DATABASE_URL=
REDIS_URL=
